# Repository-wide ignores. Platform directories (macos/, windows/, linux/) add
# their own toolchain-specific rules on top of these.

# Release artifacts. Published to GitHub Releases, never committed.
dist/

# Signing material. Must never be committed; supplied via CI secrets or the
# local keychain/certificate store.
*.p12
*.pfx
*.cer
*.certSigningRequest
*.provisionprofile
.env
.env.local

# Vendored binary artifacts are never committed. The local runtime cache is
# developer-only, and the Sparkle updater framework is fetched on demand by
# macos/tools/fetch-sparkle.sh against a pinned checksum.
macos/Vendor/

# OS cruft
.DS_Store
Thumbs.db

# Python bytecode from packaging helper modules
__pycache__/
