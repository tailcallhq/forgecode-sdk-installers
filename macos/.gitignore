# macOS/SwiftPM-specific ignores. Repository-wide rules (dist/, signing
# material, OS cruft) live in ../.gitignore.

# Swift Package Manager build output. There is no Package.resolved while the
# package has no dependencies; if SwiftPM creates one later it must be reviewed
# rather than ignored so packaging can reject remote dependency resolution.
.build/
.swiftpm/

# Intermediate build products: universal binaries, generated icons, atomic
# app/DMG stages, verification mounts, focused fixtures, and packaging logs.
.build-artifacts/
